@page "/"
@inject NavigationManager NavMgr

<PageTitle>LINQ // TO NOWHERE</PageTitle>

<section class="hero-panel">
    <p class="eyebrow">POST NETWORK // 01</p>
    <h1>Explore the signal.</h1>
    <p class="hero-copy">A minimal command center for posts, built with Blazor and LINQ.</p>
    
    <AuthorizeView>
        <Authorized>
            <h3>Hello, @context.User.Identity.Name</h3>
            <a class="btn btn-primary" href="posts">Browse posts <span aria-hidden="true">→</span></a>
        </Authorized>
        <NotAuthorized>
            <h3>You are not are not logged in!</h3>
            <a class="btn btn-primary" href="login">Log in <span aria-hidden="true">→</span>
            </a>
        </NotAuthorized>
    </AuthorizeView>

</section>
