@page "/posts/{Id:int}"
@using DTOs
@using WebApp.Services
@inject IPostService PostService
@inject ICommentService CommentService

<PageTitle>@(post?.Title ?? "Post")</PageTitle>

<a class="back-link" href="posts">← Back to posts</a>

@if (isPostLoading)
{
    <p class="text-secondary" role="status">Loading post…</p>
}
else if (postNotFound)
{
    <div class="alert alert-warning" role="alert">This post no longer exists.</div>
}
else if (postErrorMessage is not null)
{
    <div class="alert alert-danger" role="alert">@postErrorMessage</div>
}
else if (post is not null)
{
    <article class="post-detail-panel mb-5">
        <ContentActionButtons ItemLabel="post"/>
        <p class="eyebrow">POST // @post.Id</p>
        <h1>@post.Title</h1>
        <p class="post-body">@post.Body</p>
        <p class="text-secondary mb-0">By @post.UserName</p>
    </article>

    <section aria-labelledby="comments-heading">
        <h2 id="comments-heading">Comments</h2>

        <EditForm class="comment-composer" Model="commentModel" OnValidSubmit="PostCommentAsync">
            <DataAnnotationsValidator />
            <ValidationSummary class="validation-summary" />

            @if (commentSubmissionError is not null)
            {
                <div class="alert alert-danger" role="alert">@commentSubmissionError</div>
            }

            <label class="form-label" for="comment-body">Add a comment</label>
            <InputTextArea id="comment-body"
                           class="form-control comment-composer-input"
                           @bind-Value="commentModel.Body"
                           placeholder="Join the conversation" />
            <ValidationMessage For="() => commentModel.Body" />

            <div class="comment-composer-actions">
                <button class="btn btn-primary" type="submit" disabled="@isSubmittingComment">
                    @(isSubmittingComment ? "Posting…" : "Post comment")
                </button>
            </div>
        </EditForm>

        @if (isCommentsLoading)
        {
            <p class="text-secondary" role="status">Loading comments…</p>
        }
        else if (commentsErrorMessage is not null)
        {
            <div class="alert alert-danger" role="alert">@commentsErrorMessage</div>
        }
        else if (comments.Count == 0)
        {
            <p class="text-secondary">No comments yet.</p>
        }
        else
        {
            <ol class="comment-thread">
                @foreach (CommentDTO comment in comments.OrderByDescending(comment => comment.Id))
                {
                    <li class="comment-thread-item">
                        <article class="comment-card">
                            <ContentActionButtons ItemLabel="comment"/>
                            <div class="content-byline">
                                <span class="content-author">@comment.UserName</span>
                            </div>
                            <p class="content-body mb-0">@comment.Body</p>
                        </article>
                    </li>
                }
            </ol>
        }
    </section>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private PostDTO? post;
    private IReadOnlyCollection<CommentDTO> comments = [];
    private readonly CreateCommentFormModel commentModel = new();
    private bool isPostLoading;
    private bool isCommentsLoading;
    private bool isSubmittingComment;
    private bool postNotFound;
    private string? postErrorMessage;
    private string? commentsErrorMessage;
    private string? commentSubmissionError;

    protected override async Task OnParametersSetAsync()
    {
        await LoadPostAsync();
    }

    private async Task LoadPostAsync()
    {
        isPostLoading = true;
        isCommentsLoading = false;
        post = null;
        comments = [];
        postNotFound = false;
        postErrorMessage = null;
        commentsErrorMessage = null;
        commentSubmissionError = null;

        try
        {
            post = await PostService.GetByIdAsync(Id);
        }
        catch (HttpRequestException exception) when (exception.StatusCode == System.Net.HttpStatusCode.NotFound)
        {
            postNotFound = true;
        }
        catch (HttpRequestException)
        {
            postErrorMessage = "The post could not be loaded. Make sure the Web API is running and try again.";
        }
        finally
        {
            isPostLoading = false;
        }

        if (post is not null)
        {
            await LoadCommentsAsync();
        }
    }

    private async Task LoadCommentsAsync()
    {
        isCommentsLoading = true;

        try
        {
            comments = await CommentService.GetManyAsync(postId: Id);
        }
        catch (HttpRequestException)
        {
            commentsErrorMessage = "Comments could not be loaded. Try again shortly.";
        }
        finally
        {
            isCommentsLoading = false;
        }
    }

    private async Task PostCommentAsync()
    {
        if (isSubmittingComment)
        {
            return;
        }

        isSubmittingComment = true;
        commentSubmissionError = null;

        try
        {
            CommentDTO createdComment = await CommentService.AddCommentAsync(
                new CreateCommentDTO(commentModel.Body, 1, Id));

            comments = [createdComment, .. comments];
            commentModel.Body = string.Empty;
            commentsErrorMessage = null;
        }
        catch (HttpRequestException)
        {
            commentSubmissionError = "Your comment could not be posted. Make sure the Web API is running and try again.";
        }
        finally
        {
            isSubmittingComment = false;
        }
    }
}
