@page "/posts/new"
@using DTOs
@using System.Security.Claims
@using WebApp.Services
@inject IPostService PostService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthProvider

<PageTitle>New post</PageTitle>

<a class="back-link" href="posts">← Back to posts</a>

<section class="composer-panel" aria-labelledby="create-post-heading">
    <p class="eyebrow">POSTS // NEW</p>
    <h1 id="create-post-heading">Create a post</h1>
    <p class="composer-copy">Share a thought with the network.</p>

    @if (errorMessage is not null)
    {
        <div class="alert alert-danger" role="alert">@errorMessage</div>
    }

    <AuthorizeView Context="authState">
    <Authorized>
    <EditForm Model="model" OnValidSubmit="PublishAsync">
        <DataAnnotationsValidator />
        <ValidationSummary class="validation-summary" />

        <div class="mb-4">
            <label class="form-label" for="post-title">Title</label>
            <InputText id="post-title" class="form-control" @bind-Value="model.Title" />
            <ValidationMessage For="() => model.Title" />
        </div>

        <div>
            <label class="form-label" for="post-body">Post</label>
            <InputTextArea id="post-body" class="form-control composer-body-input" @bind-Value="model.Body" />
            <ValidationMessage For="() => model.Body" />
        </div>

        <div class="composer-actions">
            <a class="btn btn-outline-secondary" href="posts">Cancel</a>
            <button class="btn btn-primary" type="submit" disabled="@isSubmitting">
                @(isSubmitting ? "Publishing…" : "Publish post")
            </button>
        </div>
    </EditForm>
    </Authorized>
    <NotAuthorized><p>Please <a href="login">log in</a> to create a post.</p></NotAuthorized>
    </AuthorizeView>
</section>

@code {
    private readonly CreatePostFormModel model = new();
    private bool isSubmitting;
    private string? errorMessage;

    private async Task PublishAsync()
    {
        if (isSubmitting)
        {
            return;
        }

        isSubmitting = true;
        errorMessage = null;

        try
        {
            var user = (await AuthProvider.GetAuthenticationStateAsync()).User;
            if (user.Identity?.IsAuthenticated != true || !int.TryParse(user.FindFirst(ClaimTypes.NameIdentifier)?.Value, out int userId))
            {
                errorMessage = "Please log in to create a post.";
                return;
            }
            PostResponse createdPost = await PostService.AddPostAsync(
                new CreatePostRequest(model.Title, model.Body, userId));

            Navigation.NavigateTo($"posts/{createdPost.Id}");
        }
        catch (HttpRequestException)
        {
            errorMessage = "Your post could not be published. Make sure the Web API is running and try again.";
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
